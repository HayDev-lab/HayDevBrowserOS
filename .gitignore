# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# local notes/logs — but never the product source module:
local-*
!local-index.ts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# mimosa scanner state (session-local)
.mimosa/

# Reproducible integration checkout (generated from source-lock.json)
/electron-app/.cache/

# Closure run evidence (logs, snapshots, synthetic fixtures) — stays local
/artifacts/
.cisim/
.vischeck/
.dwtest/
