{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HayDevBrowser",
  "version": "0.1.3",
  "identifier": "com.haydev.browser",
  "build": {
    "frontendDist": "../.vite/build/renderer",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run build:internal-pages && npm run dev:vite",
    "beforeBuildCommand": "node scripts/verify-vpn-component.mjs && npm run prepare:windows-runtimes && npm run build:internal-pages && npm run build:vite"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../resources/vpn/arman-vpn-core.exe": "resources/vpn/arman-vpn-core.exe",
      "../resources/vpn/LICENSE.txt": "resources/vpn/LICENSE.txt",
      "../resources/vpn/NOTICE.txt": "resources/vpn/NOTICE.txt",
      "../resources/vpn/source-lock.json": "resources/vpn/source-lock.json",
      "../.vite/build/internal/": "internal/",
      "../resources/packaged-runtimes/": "resources/runtimes/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
