"""Windows shim for the Unix-only stdlib `pwd` module.

SearXNG's searx.valkeydb imports pwd at module scope for Unix privilege
drop support. On Windows the module does not exist; stubs below satisfy
the import and are never used at runtime (no privilege drop on Windows).
"""
__all__ = ["getpwnam", "getpwuid", "getpwall"]


class _Pw:
    pw_name = "haydev"
    pw_uid = 0
    pw_gid = 0
    pw_gecos = ""
    pw_dir = "/"
    pw_shell = ""


def getpwnam(name):
    return _Pw()


def getpwuid(uid):
    return _Pw()


def getpwall():
    return []
