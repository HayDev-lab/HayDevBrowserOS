{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext", "DOM"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      // Production-path tests import the REAL Perplexica sources (vitest
      // resolves the same alias from vitest.config.ts).
      "@/*": [".cache/perplexica/src/*"]
    }
  },
  "exclude": ["tests/gemini-thought-signature.test.ts", "tests/integration-runtime-contract.test.ts"],
  "include": [
    "tests/**/*.ts",
    "src/shared/**/*.ts",
    "src/main/browser/pure/**/*.ts",
    "src/main/browser/storage/**/*.ts",
    "src/main/browser/incognito/pure/**/*.ts",
    "src/main/browser/vault/pure/**/*.ts",
    "src/main/browser/agent/pure/**/*.ts",
    "src/main/browser/actions/pure/**/*.ts",
    "src/main/browser/research/pure/**/*.ts",
    "src/main/browser/research/runtime/**/*.ts",
    "src/main/browser/mcp/pure/**/*.ts",
    "src/main/browser/mcp/runtime/**/*.ts",
    "src/main/browser/darkweb/pure/**/*.ts",
    "src/main/browser/darkweb/runtime/**/*.ts",
    "src/main/browser/runtime/engine/pure/**/*.ts",
    "src/main/browser/runtime/engine/runtime/**/*.ts",
    "vitest.config.ts"
  ]
}
