{
  "name": "haydev-browser-os",
  "productName": "HayDev Browser OS",
  "version": "0.1.0",
  "description": "Personal Windows agentic browser РІР‚вЂќ Tauri 2 (Rust + WebView2 + TypeScript + React).",
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "HayDev Labs"
  },
  "scripts": {
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "test:watch": "vitest --config vitest.config.ts",
    "start": "npm run dev:tauri",
    "dev:vite": "vite -c vite.renderer.config.ts",
    "dev:tauri": "tauri dev",
    "build:internal-pages": "node scripts/build-internal-pages.mjs",
    "bundle:runtimes": "node scripts/bundle-runtimes.mjs",
    "build:vite": "vite build -c vite.renderer.config.ts",
    "build:tauri": "tauri build",
    "integration:prepare": "node scripts/prepare-perplexica.mjs",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/expect": "^4.1.11",
    "electron": "^44.3.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.0",
    "ollama": "^0.6.3",
    "playwright-core": "^1.64.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.5.4",
    "vite": "8.3.4",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tauri-apps/api": "^2.11.1",
    "dotenv": "^17.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
