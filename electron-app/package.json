{
  "name": "personal-agentic-browser",
  "productName": "Personal Agentic Browser",
  "version": "0.1.0",
  "description": "Personal Windows agentic browser — Production v1 (Electron + Chromium + TypeScript + React).",
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Personal V1"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "node_modules/.bin/eslint \"src/**/*.{ts,tsx}\"",
    "test": "node_modules/.bin/vitest run --config vitest.config.ts",
    "test:watch": "node_modules/.bin/vitest --config vitest.config.ts",
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "electron-vite build || true"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-vite": "^7.5.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/expect": "^4.1.11",
    "electron": "^31.3.1",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
